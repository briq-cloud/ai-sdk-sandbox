{
  "name": "@briq-cloud/ai-sdk-sandbox",
  "version": "0.1.2",
  "description": "briq sandboxes for the Vercel AI SDK harness: a network sandbox session built on @briq-cloud/sdk.",
  "keywords": ["briq", "ai-sdk", "harness", "sandbox", "agents"],
  "homepage": "https://briq.cloud",
  "bugs": {
    "email": "hello@briq.cloud"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/briq-cloud/ai-sdk-sandbox.git"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=22.6"
  },
  "packageManager": "pnpm@9.7.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "prepublishOnly": "node build.mjs"
  },
  "dependencies": {
    "@briq-cloud/sdk": "^0.1.1"
  },
  "peerDependencies": {
    "@ai-sdk/harness": "^1.0.174",
    "@ai-sdk/provider-utils": "^5.0.75"
  },
  "devDependencies": {
    "@ai-sdk/harness": "1.0.174",
    "@ai-sdk/provider-utils": "5.0.75",
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.18.0",
    "esbuild": "0.25.12",
    "typescript": "^5.6.3",
    "vitest": "3.2.4",
    "zod": "3.25.76"
  }
}
